#!/usr/bin/env python3
"""Thin launcher: run the CLI from a source checkout without installing.

The installed console script (`apple-calendar`, provided by pyproject)
does the same thing after `pip install -e .`.
"""
import os
import sys

sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src")
)

from apple_calendar.cli import main

if __name__ == "__main__":
    main()